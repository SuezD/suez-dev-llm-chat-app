{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "suez-dev-llm-chat-app",
  "main": "src/index.ts",
  "compatibility_date": "2025-10-08",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],

  "assets": {
    "binding": "ASSETS",
    "directory": "./public"
  },

  "observability": {
    "enabled": true
  },

  "ai": {
    "binding": "AI"
  },

  "rules": [
    {
      "type": "Text",
      "globs": ["**/*.md"],
      "fallthrough": true
    }
  ],

  "upload_source_maps": true
}
